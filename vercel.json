{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "installCommand": "pnpm install --no-frozen-lockfile",
    "functions": {
        "api/index.ts": {
            "maxDuration": 30
        }
    }
}