"00","contains_image":false,"image_link":null,"options":[{"answer_text":"Leave your vehicles engine running without supervision","answer_number":"A","correct_answer":false},{"answer_text":"Allow someone to ride on the bumper of your vehicle","answer_number":"B","correct_answer":false},{"answer_text":"Put your arm out of the window only to give legal hand signals","answer_number":"C","correct_answer":true}],"source_id":2,"is_duplicate":false,"is_official":false},{"id":11,"question_number":11,"question_text":"If you see that someone wants to overtake you, you must...\n(i) Not drive faster\n(ii) Keep to the left as far as is safe\n(iii) Give hand signals to allow the person to pass safely\nSELECT THE CORRECT COMBINATION","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"only (i) and (ii) are correct","answer_number":"A","correct_answer":true},{"answer_text":"All of the above are correct","answer_number":"B","correct_answer":false},{"answer_text":"(ii) is only correct","answer_number":"C","correct_answer":false}],"source_id":2,"is_duplicate":false,"is_official":false},{"id":13,"question_number":13,"question_text":"What is the longest period that a vehicle may be parked on one place on a road outside urban areas?","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"7 days","answer_number":"A","correct_answer":false},{"answer_text":"48 hours","answer_number":"B","correct_answer":false},{"answer_text":"24 hours","answer_number":"C","correct_answer":true}],"source_id":2,"is_duplicate":false,"is_official":false},{"id":14,"question_number":14,"question_text":"At an intersection...","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"You can pass another vehicle waiting to turn right on his left side by going off the road","answer_number":"A","correct_answer":false},{"answer_text":"You can stop in it to off load passengers","answe