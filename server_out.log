":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"The driver should follow at a safe distance and be able to stop the vehicle safely in an emergency situation or should the vehicle in front slow down or stop.","answer_number":"A","correct_answer":true},{"answer_text":"The driver should be able to see the rear tyres of the vehicle in front.","answer_number":"B","correct_answer":false},{"answer_text":"The driver should follow another vehicle keeping three car lengths behind.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1455,"question_number":577,"question_text":"The following vehicles are not allowed on a freeway?","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"A vehicle driven by a learner driver.","answer_number":"A","correct_answer":false},{"answer_text":"A tractor, except when it is used in connection with construction or maintenance of the freeway.","answer_number":"B","correct_answer":true},{"answer_text":"A vehicle used for the conveyance of school children.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1456,"question_number":578,"question_text":"When moving off from a stationary position at the side of the road, what is the responsibility of the driver?","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"The driver must ensure that it is safe and that he/she will not interfere with traffic approaching from any direction.","answer_number":"A","correct_answer":true},{"answer_text":"The driver must join other traffic as quickly as possible.","answer_number":"B","correct_answer":false},{"answer_text":"The driver must indicate his/her intention and then move off.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1457,"question_number":579,"qu