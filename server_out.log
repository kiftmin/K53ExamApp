swer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1501,"question_number":623,"question_text":"When is overtaking prohibited?","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"When approaching any place where passing could cause a hazard to traffic approaching from the opposite direction.","answer_number":"A","correct_answer":true},{"answer_text":"When passing a school.","answer_number":"B","correct_answer":false},{"answer_text":"When driving at night.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1502,"question_number":624,"question_text":"Your vehicle's headlights must be switched on ... (i) at any time of the day when you cannot see persons and vehicles 150 m in front of you. (ii) from sunset to sunrise. (iii) when it rains and you cannot see vehicles 100 m in front of you. SELECT THE CORRECT COMBINATION.","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"Only (i) and (ii) are correct.","answer_number":"A","correct_answer":false},{"answer_text":"Only (ii) is correct.","answer_number":"B","correct_answer":false},{"answer_text":"All of the above are correct.","answer_number":"C","correct_answer":true}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1446,"question_number":568,"question_text":"When control number 9 is used, the distance it takes the driver of a motor vehicle to stop it is ... (i) longer on a wet road than on a dry road. (ii) longer if the vehicle is travelling at a higher speed. (iii) longer if the vehicle is loaded. SELECT THE CORRECT COMBINATION","category":3,"license_code":"00","contains_image":true,"image_link":null,"options":[{"answer_text":"All of the above are correct.","answer_number":"A","correct_answer":true},{"answer_text":"None of the above are correct.","answer_number":"B","correct_answer":false},{"answer_text":"Only (i) is correct.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1447,"question_number":569,"question_text":"The following control is used to change the direction of the vehicle:","category":3,"license_code":"00","contains_image":true,"image_link":null,"options":[{"answer_text":"6.","answer_number":"A","correct_answer":false},{"answer_text":"4.","answer_number":"B","correct_answer":true},{"answer_text":"5.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1448,"question_number":570,"question_text":"The use of a temporary sign implies that for some reason ...","category":2,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"traffic has to move slowly.","answer_number":"A","correct_answer":false},{"answer_text":"circumstances on the roadway are not normal.","answer_number":"B","correct_answer":true},{"answer_text":"the rules of the road do not apply.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1449,"question_number":571,"question_text":"If you only have a learner's licence for a heavy motor vehicle, ... (i) then there must be someone with you in the vehicle with the same driving licence. (ii) you are not allowed to drive on a freeway. (iii) no passengers are allowed with you in the vehicle. SELECT THE CORRECT COMBINATION","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"All the above are correct.","answer_number":"A","correct_answer":false},{"answer_text":"Only (i) is correct.","answer_number":"B","correct_answer":true},{"answer_text":"Only (i) and (iii) are correct.","answer_number":"C","correct_answer":false}],"source_id":5,"is_duplicate":false,"is_official":false},{"id":1450,"question_number":572,"question_text":"Whilst the vehicle is in motion a driver may ...","category":1,"license_code":"00","contains_image":false,"i