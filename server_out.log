":true},{"answer_text":"(ii) only are correct","answer_number":"B","correct_answer":false},{"answer_text":"All of the above are correct.","answer_number":"C","correct_answer":false}],"source_id":3,"is_duplicate":true,"is_official":false},{"id":776,"question_number":276,"question_text":"If you come to a robot and the red light flashes, you must","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"stop and wait for the light to change green before you go.","answer_number":"A","correct_answer":false},{"answer_text":"stop and go if it is safe to do so.","answer_number":"B","correct_answer":true},{"answer_text":"look out for a roadblock as the light shows you a police stop.","answer_number":"C","correct_answer":false}],"source_id":3,"is_duplicate":true,"is_official":false},{"id":1380,"question_number":502,"question_text":"If another vehicle intends to overtake you, you must...","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"Keep to the left as possible as you can.","answer_number":"A","correct_answer":false},{"answer_text":"Do not accelerate the speed of your vehicle.","answer_number":"B","correct_answer":false},{"answer_text":"Both (a) and (b).","answer_number":"C","correct_answer":true}],"source_id":4,"is_duplicate":false,"is_official":false},{"id":1375,"question_number":497,"question_text":"Which control helps the driver when engaging or disengaging a gear?","category":3,"license_code":"00","contains_image":true,"image_link":null,"options":[{"answer_text":"8.","answer_number":"A","correct_answer":true},{"answer_text":"7.","answer_number":"B","correct_answer":false},{"answer_text":"3.","answer_number":"C","correct_answer":false}],"source_id":4,"is_duplicate":false,"is_official":false},{"id":1376,"question_number":498,"question_text":"To change gears, which controls are used?","category":3,"license_code":"00","contains_image":true,"image_link":null,"options":[{"answer_