":false,"is_official":false},{"id":18,"question_number":18,"question_text":"You may overtake another vehicle on the left hand side...\n(i) When that vehicle is going to turn right and the road is wide enough that it is not necessary to drive on the shoulder\n(ii) Where the road has 2 lanes for traffic in the same direction\n(iii) If a police officer instructs you to do so\nSELECT THE CORRECT COMBINATION","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"(iii) only is correct","answer_number":"A","correct_answer":false},{"answer_text":"(ii) and (iii) only is correct","answer_number":"B","correct_answer":false},{"answer_text":"All of the above are correct","answer_number":"C","correct_answer":true}],"source_id":2,"is_duplicate":false,"is_official":false},{"id":8,"question_number":8,"question_text":"Unless otherwise shown by a sign, the general speed limit in an urban area is ...km/h.","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"60","answer_number":"A","correct_answer":true},{"answer_text":"80","answer_number":"B","correct_answer":false},{"answer_text":"100","answer_number":"C","correct_answer":false}],"source_id":2,"is_duplicate":true,"is_official":false},{"id":12,"question_number":12,"question_text":"The furthest that your vehicle's dim light may shine in front of you, is...m","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"45","answer_number":"A","correct_answer":true},{"answer_text":"100","answer_number":"B","correct_answer":false},{"answer_text":"150","answer_number":"C","correct_answer":false}],"source_id":2,"is_duplicate":true,"is_official":false},{"id":825,"question_number":325,"question_text":"At an intersection","category":1,"license_code":"00","contains_image":false,"image_link":null,"options":[{"answer_text":"You must yield to on coming traffic if you want to turn right","answer_number":"A","correct